<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WAVE.App.Views.CredentialPromptWindow"
        Title="WAVE — Credencial de rede" Height="400" Width="380"
        WindowStartupLocation="CenterOwner" CanResize="False"
        Background="{StaticResource BrushBackground}" Foreground="{StaticResource BrushText}">
    <Border Padding="26">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" Margin="0,0,0,4" TextWrapping="Wrap" />
            <TextBlock Text="Rede protegida. Informe a credencial para conectar." Classes="muted" TextWrapping="Wrap" Margin="0,0,0,16" />

            <Label Content="Sen_ha / Passphrase" Target="PassphraseInput" Classes="field" />
            <TextBox x:Name="PassphraseInput" PasswordChar="●" Height="30" Margin="0,2,0,10" ToolTip.Tip="Senha da rede protegida" />

            <StackPanel x:Name="EnterprisePanel">
                <Label Content="_Usuário" Target="UsernameInput" Classes="field" />
                <TextBox x:Name="UsernameInput" Height="30" Margin="0,2,0,10" ToolTip.Tip="Usuário de autenticação (rede Enterprise)" />

                <Label Content="_Domínio" Target="DomainInput" Classes="field" />
                <TextBox x:Name="DomainInput" Height="30" Margin="0,2,0,10" ToolTip.Tip="Domínio de autenticação (rede Enterprise)" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource BrushFailed}" TextWrapping="Wrap"
                       Margin="0,2,0,10" IsVisible="False" />

            <Button Content="Conectar" Click="OnSubmit" IsDefault="True"
                    Classes="action" Height="42" Margin="0,6,0,0"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
