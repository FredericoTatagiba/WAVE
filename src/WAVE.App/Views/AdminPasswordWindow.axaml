<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WAVE.App.Views.AdminPasswordWindow"
        Title="WAVE — Administrador" Height="320" Width="380"
        WindowStartupLocation="CenterOwner" CanResize="False"
        Background="{StaticResource BrushBackground}" Foreground="{StaticResource BrushText}">
    <Border Padding="26">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource BrushAccent}" Margin="0,0,0,4" TextWrapping="Wrap" />
            <TextBlock x:Name="SubtitleText" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,16" />

            <Label Content="Sen_ha" Target="PasswordInput" Classes="field" />
            <TextBox x:Name="PasswordInput" PasswordChar="●" Height="30" Margin="0,2,0,10" />

            <StackPanel x:Name="ConfirmPanel" IsVisible="False">
                <Label Content="_Confirmar senha" Target="ConfirmInput" Classes="field" />
                <TextBox x:Name="ConfirmInput" PasswordChar="●" Height="30" Margin="0,2,0,10" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource BrushFailed}" TextWrapping="Wrap"
                       Margin="0,2,0,10" IsVisible="False" />

            <Button x:Name="SubmitButton" Click="OnSubmit" IsDefault="True"
                    Classes="action" Height="42" Margin="0,6,0,0"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
