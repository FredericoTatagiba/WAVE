<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WAVE.App.Controls.ResponsiveSplitView"
             x:Name="Root">
    <Grid x:Name="RootGrid">
        <!-- WPF reached the control with RelativeSource AncestorType={x:Type UserControl};
             Avalonia has no x:Type, and binds to a named ancestor directly. -->
        <ContentPresenter x:Name="PrimaryHost" Content="{Binding #Root.PrimaryContent}" />
        <ContentPresenter x:Name="SecondaryHost" Content="{Binding #Root.SecondaryContent}" />
    </Grid>
</UserControl>
