<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WAVE.App.Controls.NetworkButton">
    <Button Command="{Binding RunCommand}"
            IsEnabled="{Binding IsEnabled}"
            Background="{Binding State, Converter={StaticResource StateToBrush}}"
            Classes="touch"
            Margin="6">
        <StackPanel>
            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.85" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Info}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />

            <!-- Marks which button the operator is waiting on. The colour alone says
                 "connecting"; the animation says "still working, not stuck". -->
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,4,0,0"
                         IsVisible="{Binding IsConnecting}"
                         Foreground="#FF102027" Background="Transparent" />
        </StackPanel>
    </Button>
</UserControl>
